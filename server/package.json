{
  "name": "foodflow-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:seed:prod": "node dist/seed.js",
    "prisma:studio": "prisma studio",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "owner:bootstrap": "tsx src/bootstrap-owner.ts",
    "owner:bootstrap:prod": "node dist/bootstrap-owner.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.23.1"
  },
  "engines": {
    "node": ">=20"
  }
}
