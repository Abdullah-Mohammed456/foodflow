generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RestaurantRole {
  OWNER
  MANAGER
  KITCHEN
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum MenuItemSize {
  SMALL
  MEDIUM
  LARGE
  SINGLE
  DOUBLE
  REGULAR
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships RestaurantMember[]
  orders      Order[]

  @@map("users")
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    RestaurantMember[]
  categories Category[]
  menuItems  MenuItem[]
  orders     Order[]

  @@index([slug])
  @@map("restaurants")
}

model RestaurantMember {
  id           String         @id @default(cuid())
  userId       String
  restaurantId String
  role         RestaurantRole
  createdAt    DateTime       @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@index([restaurantId])
  @@map("restaurant_members")
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  description  String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@unique([restaurantId, slug])
  @@unique([id, restaurantId])
  @@index([restaurantId, isActive, sortOrder])
  @@map("categories")
}

model MenuItem {
  id              String   @id @default(cuid())
  restaurantId    String
  categoryId      String
  name            String
  slug            String
  description     String?
  imageUrl        String?
  isCombo         Boolean  @default(false)
  isSpicy         Boolean  @default(false)
  prepTimeMinutes Int
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  variants   MenuItemVariant[]
  orderItems OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isAvailable])
  @@index([restaurantId, categoryId, isAvailable])
  @@map("menu_items")
}

model MenuItemVariant {
  id          String       @id @default(cuid())
  menuItemId  String
  size        MenuItemSize
  price       Decimal      @db.Decimal(10, 2)
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([menuItemId, size])
  @@index([menuItemId, isAvailable])
  @@map("menu_item_variants")
}

model Order {
  id           String      @id @default(cuid())
  publicId     String      @unique @default(cuid())
  customerId   String
  restaurantId String
  orderType    OrderType
  status       OrderStatus @default(PENDING)
  revision     Int         @default(0)
  prepDueAt    DateTime
  subtotal     Decimal     @db.Decimal(10, 2)
  deliveryFee  Decimal     @default(0) @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?
  deliveryAddress String?
  checkoutKey String
  requestHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@unique([customerId, checkoutKey])
  @@index([customerId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, status, prepDueAt])
  @@map("orders")
}

model OrderItem {
  id                  String        @id @default(cuid())
  orderId             String
  menuItemId          String
  menuItemVariantId   String?
  nameSnapshot        String
  descriptionSnapshot String?
  sizeSnapshot        MenuItemSize?
  isComboSnapshot     Boolean       @default(false)
  prepTimeMinutesSnapshot Int       @default(15)
  unitPrice           Decimal       @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal       @db.Decimal(10, 2)
  createdAt           DateTime      @default(now())

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  menuItemVariant MenuItemVariant? @relation(fields: [menuItemVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}
